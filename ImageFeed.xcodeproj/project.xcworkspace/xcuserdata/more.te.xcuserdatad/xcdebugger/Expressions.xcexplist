<?xml version="1.0" encoding="UTF-8"?>
<VariablesViewState
   version = "1.0">
   <ContextStates>
      <ContextState
         contextName = "OAuth2TokenStorageService.token.getter:OAuth2TokenStorageService.swift">
         <PersistentStrings>
            <PersistentString
               value = "UserDefaults.standard.string(forKey: Constants.Token.storageKey)">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
   </ContextStates>
</VariablesViewState>
